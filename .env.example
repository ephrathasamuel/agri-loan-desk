# Copy to .env (docker-compose) and/or api/.env (local API) and fill in.
# Never commit the real file.

# Signs loan officers' session tokens. Use a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# The first admin account, created on start-up if no admin exists yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: enables the AI briefing note (Claude). Everything else works without it.
ANTHROPIC_API_KEY=

# Local runs default to SQLite (api/data/agri_loan_desk.db).
# docker-compose sets a PostgreSQL URL itself.
# DATABASE_URL=postgresql+psycopg://agriloan:agriloan@localhost:5432/agriloan

# PostgreSQL password used by docker-compose.
POSTGRES_PASSWORD=
